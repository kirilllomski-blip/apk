<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#151821"
    android:padding="8dp"
    android:gravity="center">

    <!-- Заголовок: Имя питомца и уровень -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_pet_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🐱 Оливер"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_pet_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lv.1 ❤️❤️❤️"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Изображение 3D Pixel Pet -->
    <ImageView
        android:id="@+id/widget_pet_image"
        android:layout_width="96dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:contentDescription="Pixel Pet" />

    <!-- Статус сытости и настроения -->
    <TextView
        android:id="@+id/widget_pet_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="🍖 85% • ⚡ 90% • 💖 100%"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:layout_marginBottom="4dp" />

    <!-- Кнопки действий прямо на виджете -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/widget_btn_feed"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="🍎 Корм"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#1E2330" />

        <Button
            android:id="@+id/widget_btn_love"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="❤️ Гладь"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#1E2330" />
    </LinearLayout>

</LinearLayout>
